# ==============================================================================
# Walking Calorie Calculator - Environment Configuration
# ==============================================================================
# Duplicate this file to .env.local and configure your live credentials.

# 1. Branding & Site Identity
NEXT_PUBLIC_SITE_NAME="WalkingCalorieCalculator.net"
NEXT_PUBLIC_DOMAIN="walkingcaloriecalculator.net"
NEXT_PUBLIC_CANONICAL_URL="https://walkingcaloriecalculator.net"
NEXT_PUBLIC_CONTACT_EMAIL="contact@walkingcaloriecalculator.net"

# 2. Author & Editorial Persona (Fill in your real name and credentials)
NEXT_PUBLIC_AUTHOR_NAME="Editorial Fitness Team"
NEXT_PUBLIC_AUTHOR_BIO="Our team synthesizes peer-reviewed exercise science, clinical walking guidelines, and physical activity compendiums to make fitness metrics accessible, transparent, and accurate."

# 3. Google Analytics 4 (Leave blank until ready to measure traffic)
NEXT_PUBLIC_GA4_ID="" # e.g. "G-XXXXXXXXXX"

# 4. Google AdSense (Leave blank until approved by Google AdSense)
NEXT_PUBLIC_ADSENSE_CLIENT_ID="" # e.g. "ca-pub-XXXXXXXXXXXXXXXX"
NEXT_PUBLIC_ADS_TEST_MODE="true"
